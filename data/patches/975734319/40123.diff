+test("reserves home and end for navigation", () => {
+  const config = resolve({}, { terminalSuspend: true })
+
+  expect(config.keybinds.get("input.buffer.home")).toEqual([])
+  expect(config.keybinds.get("input.buffer.end")).toEqual([])

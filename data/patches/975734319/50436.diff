diff --git a/packages/tui/test/renderer-listener-budget.test.ts b/packages/tui/test/renderer-listener-budget.test.ts
new file mode 100644
index 000000000000..a0361d13c90a
--- /dev/null
+++ b/packages/tui/test/renderer-listener-budget.test.ts
@@ -0,0 +1,16 @@
+import { expect, test } from "bun:test"
+import { createAppFixture } from "./fixture/app"
+
+test("local app stays within the renderer listener budget", async () => {
+  await using app = await createAppFixture({
+    channel: "local",
+    fetch: (url) =>
+      url.pathname === "/api/info"
+        ? Response.json({ version: "test", pid: 0, urls: ["http://test"], paths: { tmp: "/tmp" } })
+        : undefined,
+  })
+  await app.ready
+  await Bun.sleep(100)
+
+  expect(app.renderer.listenerCount("resize")).toBeLessThanOrEqual(app.renderer.getMaxListeners())
+})

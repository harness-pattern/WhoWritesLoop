+            self.assertTrue(any("AX-02" in e for e in errors))
+
+    def test_load_soul_requires_paired_suite(self):
+        with tempfile.TemporaryDirectory() as tmpdir:
+            with open(os.path.join(tmpdir, "SOUL.md"), "w") as fh:

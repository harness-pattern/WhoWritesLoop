+            suite["section_a"] = [p for p in suite["section_a"] if p.get("axiom") != "AX-02"]
+            with open(os.path.join(tmpdir, "SOUL.suite.yaml"), "w") as fh:
+                yaml.safe_dump(suite, fh)
+            soul, errors = load_soul(tmpdir)

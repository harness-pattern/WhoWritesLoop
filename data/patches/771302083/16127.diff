+import type { DeploymentCapabilities } from "#/manifests/types";
+import { createSetup } from "./manifest-test-data";
+
+const SETUP = createSetup({
+  form: {
+    args: {
+      widgetName: {
+        type: "text",
+        label: "Widget name",
+        help: "What to call it.",
+        required: true,
+        constraints: { maxLength: 10 },
+      },
+      matchPhrase: {
+        type: "text",

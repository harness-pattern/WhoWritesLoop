+        assert "blocked" not in caplog.text.lower()
+        assert result == obj
+    finally:
+        _lg_msgpack._CUSTOM_SAFE_MSGPACK_TYPES.discard(
+            ("tests.test_jsonplus", "AnotherPydantic")
+        )
+
